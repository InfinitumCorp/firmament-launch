{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Firmament Network / FIRM Wallet launch site.
  // Static pages in ./public; src/index.js only answers /api/* (CPO waitlist).
  "name": "firmament-launch",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  // Global users run on US servers (Ashburn, Virginia); Russia is served by the ru.* copies on Yandex Cloud.
  "placement": { "region": "gcp:us-east4" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "kv_namespaces": [{ "binding": "WAITLIST" }],
  // Optional classic reCAPTCHA (free v2 checkbox, not Enterprise) for POST /api/waitlist.
  // Stays off until both are set. Put values in .dev.vars locally, or:
  //   npx wrangler secret put RECAPTCHA_SITE_KEY
  //   npx wrangler secret put RECAPTCHA_SECRET_KEY
  // Never commit either value. See README "Spam protection".
  "routes": [
    { "pattern": "firmnetwork.app", "custom_domain": true },
    { "pattern": "www.firmnetwork.app", "custom_domain": true },
    { "pattern": "firmwallet.app", "custom_domain": true },
    { "pattern": "www.firmwallet.app", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
